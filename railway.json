{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "ml_guard/backend/Dockerfile",
        "context": "."
    },
    "deploy": {
        "startCommand": "sh -c 'uvicorn ml_guard.backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000}'",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE"
    }
}