# ML Guard v7.2 — Environment Configuration Template
# Copy to .env and fill in your values. Never commit .env to git.

# ── Application ──────────────────────────────────────────────────────────────
APP_VERSION=7.2.0
DEBUG=false
PROJECT_NAME=ML Guard Governance Platform

# ── Security (CHANGE THESE IN PRODUCTION) ────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
# Use DATABASE_URL for hosted DBs (Neon, Supabase, Railway):
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mlguard

# Or use individual variables for local PostgreSQL:
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=ml_guard
# POSTGRES_PORT=5432

# ── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mlguard-artifacts

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND default to REDIS_URL if not set

# ── CORS (comma-separated origins) ───────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ── Optional LLM Integrations ────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...    # For LLM safety eval + report summaries
# OPENAI_API_KEY=sk-...          # For advisory module

# ── Optional Auth Providers ──────────────────────────────────────────────────
# FIREBASE_PROJECT_ID=my-project
# FIREBASE_CREDENTIALS_JSON=/path/to/service-account.json
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx
