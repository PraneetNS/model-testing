# ML Guard v7.0 — Environment Configuration
# Copy this file to .env and fill in your values

# ══════════════════════════════════════════════════════
# DATABASE — Neon (recommended for production)
# ══════════════════════════════════════════════════════
# Get your connection string from https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ══════════════════════════════════════════════════════
# DATABASE — Local PostgreSQL (alternative)
# ══════════════════════════════════════════════════════
# POSTGRES_SERVER=localhost
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=ml_guard
# POSTGRES_PORT=5432

# ══════════════════════════════════════════════════════
# DATABASE — SQLite (dev-only fallback, automatic if no DB config)
# ══════════════════════════════════════════════════════
# No config needed — SQLite is the automatic default for development

# ══════════════════════════════════════════════════════
# SECURITY
# ══════════════════════════════════════════════════════
# SECRET_KEY=generate-with-openssl-rand-hex-32

# ══════════════════════════════════════════════════════
# REDIS / CELERY (optional, for async tasks)
# ══════════════════════════════════════════════════════
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ══════════════════════════════════════════════════════
# CLOUDFLARE R2 OBJECT STORAGE (for model artifacts + datasets)
# ══════════════════════════════════════════════════════
# Get your credentials from https://dash.cloudflare.com > R2 > Manage R2 API Tokens
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY=your_r2_access_key
# R2_SECRET_KEY=your_r2_secret_key
# R2_BUCKET_NAME=ml-guard-artifacts
