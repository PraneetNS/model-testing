# ── Database ────────────────────────────────
# Local dev (SQLite):
DATABASE_URL=sqlite:///./ml_guard.db
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/mlguard?sslmode=require

# ── Security ────────────────────────────────
# MIN 32 CHARS
SECRET_KEY=test_secret_key_for_structural_rescue_720
DEBUG=false

# ── Storage (MinIO / S3) ─────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mlguard
MINIO_USE_SSL=false

# ── Redis / Celery ───────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Optional: LLM summaries in certificates ──
# ANTHROPIC_API_KEY=sk-ant-...
