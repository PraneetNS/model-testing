# ─────────────────────────────────────────────────────────
# ML Guard — PRODUCTION — Cloud Deployment Configuration
# ─────────────────────────────────────────────────────────

# ── Project Info ────────────
PROJECT_NAME="ML Guard Enterprise"
ENVIRONMENT=production

# ── Security (REQUIRED) ────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_32_BYTE_HEX

# Token lifetime (minutes). 10080 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database (Neon PostgreSQL) ────────────
# Example: postgresql://neondb_owner:pass@ep-delicate-mud-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://neondb_owner:npg_SIM4XQpEFdb1@ep-delicate-mud-aizxi3by-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Redis / Celery (Cloud Provider) ────────────
# Example (Upstash): rediss://:pass@some-app.upstash.io:32400
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Object Storage (AWS S3 / Firebase) ────────────
# Currently uses local MinIO. For cloud, use S3 or Firebase.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mlguard-artifacts
MINIO_REGION=us-east-1

# ── Auth (Firebase Required for Production) ────────────
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CREDENTIALS_JSON=REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_JSON

# ── Frontend Configuration ────────────
# Provide the URL of your deployed backend API (no trailing slash)
NEXT_PUBLIC_API_BASE=https://api.yourdomain.com
# Firebase keys must be set in frontend/.env also
NEXT_PUBLIC_FIREBASE_API_KEY=...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=...
NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=...
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=...
NEXT_PUBLIC_FIREBASE_APP_ID=...
